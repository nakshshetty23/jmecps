# Supabase (auth + Postgres project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres — DATABASE_URL is the pooled runtime connection (Prisma Client,
# via @prisma/adapter-pg); DIRECT_URL is the non-pooled connection used only
# by the Prisma CLI (migrate/introspect). See prisma.config.ts.
DATABASE_URL=
DIRECT_URL=

# Cloudflare R2 (private manuscript file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Leave empty unless a public bucket domain is actually configured — see
# src/lib/storage/r2.ts's buildStoredFileUrl().
R2_PUBLIC_BASE_URL=

# Razorpay (publication fee payment gateway — Phase 3)
# RAZORPAY_KEY_ID is not secret (Razorpay's checkout widget requires it
# client-side, and it's returned from initiatePaymentAction for exactly
# that purpose) but is still read server-side only, never via NEXT_PUBLIC_*.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must never be exposed to
# the browser or committed. Use separate test-mode and live-mode credential
# sets for development vs. production — see the Razorpay Dashboard's
# API Keys and Webhooks sections.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
