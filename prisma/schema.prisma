// Prisma schema for JMECPS — Session 1.2 (Database Schema only).
// Connection URLs live in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VISITOR
  RESEARCHER
  ADMIN
  SUPER_ADMIN
}

enum ManuscriptStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  PUBLISHED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EditorialDecision {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

// id is NOT self-generated: it must equal the corresponding auth.users.id
// (Supabase Auth), populated by the handle_new_user trigger in
// prisma/rls-and-triggers.sql. Supabase owns credentials — no password_hash
// column here.
model User {
  id                        String   @id @db.Uuid
  full_name                 String
  email                     String   @unique
  institutional_affiliation String
  role                      UserRole
  email_verified            Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  manuscripts         Manuscript[] @relation("ManuscriptAuthor")
  assignedManuscripts Manuscript[] @relation("ManuscriptAssignedEditor")
  auditLogEntries     ManuscriptAuditLog[]
  editorialReviews    EditorialReview[]

  @@map("users")
}

model Manuscript {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  abstract            String           @db.Text
  keywords            String[]
  primary_author_id   String           @db.Uuid
  primary_author      User             @relation("ManuscriptAuthor", fields: [primary_author_id], references: [id])
  co_authors          Json
  institution         String
  subject_category    String
  references          Json
  file_url            String? // nullable while status = DRAFT; required by app logic before SUBMITTED
  file_hash           String? // nullable while status = DRAFT; required by app logic before SUBMITTED
  sit_conference_flag Boolean          @default(false)
  status              ManuscriptStatus
  // Soft lock for the editorial workspace ("Editor X is currently reviewing
  // this paper") — not a hard DB lock, just an advisory UUID + timestamp
  // checked/set by src/lib/actions/editorial.ts, with a TTL so an editor
  // closing their tab without releasing it doesn't lock the paper forever.
  review_lock_by String?    @db.Uuid
  review_lock_at DateTime?
  // Durable "who owns this paper" assignment — distinct from review_lock_by,
  // which is only "who has it open right now."
  assigned_editor_id String? @db.Uuid
  assigned_editor     User?  @relation("ManuscriptAssignedEditor", fields: [assigned_editor_id], references: [id])
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  payments         Payment[]
  auditLog         ManuscriptAuditLog[]
  editorialReviews EditorialReview[]

  // Full-text search index — a Postgres GENERATED STORED column (defined in
  // the migration SQL, since Prisma treats `Unsupported` types as read-only
  // and won't manage their DDL). Recomputed by Postgres itself on every
  // write, so it can never drift out of sync with the row — see
  // src/lib/search/manuscripts.ts for why this replaced a separate
  // Elasticsearch-style index.
  search_vector Unsupported("tsvector")?

  @@index([file_hash])
  @@index([status])
  @@map("manuscripts")
}

// Immutable append-only record of every lifecycle-state transition, written
// by the state machine in src/lib/state-machine/manuscript.ts. actor_id is
// nullable because SYSTEM-initiated transitions (payment webhook) have no
// human actor.
model ManuscriptAuditLog {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manuscript_id String           @db.Uuid
  manuscript    Manuscript       @relation(fields: [manuscript_id], references: [id])
  from_state    ManuscriptStatus
  to_state      ManuscriptStatus
  actor_id      String?          @db.Uuid
  actor         User?            @relation(fields: [actor_id], references: [id])
  created_at    DateTime         @default(now())

  @@index([manuscript_id])
  @@map("manuscript_audit_log")
}

// One row per review round. decision is null while an editor's rubric/notes
// are still a work-in-progress (autosaved by saveEditorialNotesAction) and
// gets set once submitEditorialDecisionAction finalizes it — at which point a
// later review round (e.g. after RESUBMITTED) starts a fresh row rather than
// overwriting this one, so the review history per manuscript is preserved.
model EditorialReview {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manuscript_id     String             @db.Uuid
  manuscript        Manuscript         @relation(fields: [manuscript_id], references: [id])
  reviewer_id       String             @db.Uuid
  reviewer          User               @relation(fields: [reviewer_id], references: [id])
  internal_notes    String             @db.Text @default("")
  author_notes      String             @db.Text @default("")
  rubric_scores     Json               @default("{}")
  decision          EditorialDecision?
  revision_deadline DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@index([manuscript_id])
  @@map("editorial_reviews")
}

// One row per manuscript subject category (currently the fixed 7 defined in
// src/lib/validations/submission.ts's SUBJECT_CATEGORIES) — lets a
// SUPER_ADMIN disable a category so it no longer appears as a choice on new
// submissions, without deleting the category itself (existing manuscripts
// already filed under it keep displaying normally). Adding a genuinely new
// category key would still require a matching label in
// SUBJECT_CATEGORY_LABELS (a code change) — this only toggles availability
// of the existing set, not free-form category creation.
model CategorySetting {
  key     String  @id
  enabled Boolean @default(true)

  @@map("category_settings")
}

// Singleton row (id is always "singleton") for journal-wide configuration.
model JournalSettings {
  id                          String   @id @default("singleton")
  journal_title               String   @default("Journal of Mechanical, Electronics and Cyber Physical Systems")
  issn                        String   @default("")
  contact_email                String   @default("")
  publisher_name               String   @default("")
  abstract_word_limit          Int      @default(300)
  stale_review_threshold_days Int      @default(5)
  // Publication fee (Article Processing Charge) for Phase 3's payment
  // gateway integration — SUPER_ADMIN-configurable via the same settings
  // form as the fields above. 0 means "not yet configured"; initiating a
  // payment refuses to proceed until a real admin sets this. Single
  // currency only: the public Publication Charges page's INR-vs-USD
  // split by author nationality isn't implementable today (no
  // nationality/country field exists anywhere), so Phase 3 uses one
  // amount + currency, defaulting to INR since JMECPS operates in India.
  publication_fee_amount   Decimal @default(0) @db.Decimal(10, 2)
  publication_fee_currency String  @default("INR")
  updated_at                   DateTime @updatedAt

  @@map("journal_settings")
}

// Audit trail specifically for role changes — separate from
// ManuscriptAuditLog, which only tracks manuscript lifecycle transitions.
model UserRoleAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id String   @db.Uuid
  previous_role  UserRole
  new_role       UserRole
  changed_by_id  String   @db.Uuid
  created_at     DateTime @default(now())

  @@index([target_user_id])
  @@map("user_role_audit_log")
}

// Generic, unified audit feed for security-relevant events that don't
// already have a dedicated table — auth events and file access. Manuscript
// transitions and role changes already have their own well-typed tables
// (ManuscriptAuditLog, UserRoleAuditLog) with purpose-built UI already built
// around their specific shapes; this doesn't replace them, but the same
// events are also mirrored here so there's one place to query "everything
// this user did," across categories, rather than joining three tables.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  resource_id String?
  ip_address  String?
  user_agent  String?
  metadata    Json?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([action])
  @@map("audit_log")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_ref String        @unique
  manuscript_id   String        @db.Uuid
  manuscript      Manuscript    @relation(fields: [manuscript_id], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  gateway_log     Json
  invoice_url     String?
  status          PaymentStatus
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@index([transaction_ref])
  @@map("payments")
}
