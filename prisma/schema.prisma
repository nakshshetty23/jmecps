// Prisma schema for JMECPS — Session 1.2 (Database Schema only).
// Connection URLs live in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VISITOR
  RESEARCHER
  ADMIN
  SUPER_ADMIN
}

enum ManuscriptStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  PUBLISHED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EditorialDecision {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

// id is NOT self-generated: it must equal the corresponding auth.users.id
// (Supabase Auth), populated by the handle_new_user trigger in
// prisma/rls-and-triggers.sql. Supabase owns credentials — no password_hash
// column here.
model User {
  id                        String   @id @db.Uuid
  full_name                 String
  email                     String   @unique
  institutional_affiliation String
  role                      UserRole
  email_verified            Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  manuscripts         Manuscript[] @relation("ManuscriptAuthor")
  assignedManuscripts Manuscript[] @relation("ManuscriptAssignedEditor")
  auditLogEntries     ManuscriptAuditLog[]
  editorialReviews    EditorialReview[]

  @@map("users")
}

model Manuscript {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  abstract            String           @db.Text
  keywords            String[]
  primary_author_id   String           @db.Uuid
  primary_author      User             @relation("ManuscriptAuthor", fields: [primary_author_id], references: [id])
  co_authors          Json
  institution         String
  subject_category    String
  references          Json
  file_url            String? // nullable while status = DRAFT; required by app logic before SUBMITTED
  file_hash           String? // nullable while status = DRAFT; required by app logic before SUBMITTED
  sit_conference_flag Boolean          @default(false)
  status              ManuscriptStatus
  // Soft lock for the editorial workspace ("Editor X is currently reviewing
  // this paper") — not a hard DB lock, just an advisory UUID + timestamp
  // checked/set by src/lib/actions/editorial.ts, with a TTL so an editor
  // closing their tab without releasing it doesn't lock the paper forever.
  review_lock_by String?    @db.Uuid
  review_lock_at DateTime?
  // Durable "who owns this paper" assignment — distinct from review_lock_by,
  // which is only "who has it open right now."
  assigned_editor_id String? @db.Uuid
  assigned_editor     User?  @relation("ManuscriptAssignedEditor", fields: [assigned_editor_id], references: [id])
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  payments         Payment[]
  auditLog         ManuscriptAuditLog[]
  editorialReviews EditorialReview[]

  @@index([file_hash])
  @@index([status])
  @@map("manuscripts")
}

// Immutable append-only record of every lifecycle-state transition, written
// by the state machine in src/lib/state-machine/manuscript.ts. actor_id is
// nullable because SYSTEM-initiated transitions (payment webhook) have no
// human actor.
model ManuscriptAuditLog {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manuscript_id String           @db.Uuid
  manuscript    Manuscript       @relation(fields: [manuscript_id], references: [id])
  from_state    ManuscriptStatus
  to_state      ManuscriptStatus
  actor_id      String?          @db.Uuid
  actor         User?            @relation(fields: [actor_id], references: [id])
  created_at    DateTime         @default(now())

  @@index([manuscript_id])
  @@map("manuscript_audit_log")
}

// One row per review round. decision is null while an editor's rubric/notes
// are still a work-in-progress (autosaved by saveEditorialNotesAction) and
// gets set once submitEditorialDecisionAction finalizes it — at which point a
// later review round (e.g. after RESUBMITTED) starts a fresh row rather than
// overwriting this one, so the review history per manuscript is preserved.
model EditorialReview {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manuscript_id     String             @db.Uuid
  manuscript        Manuscript         @relation(fields: [manuscript_id], references: [id])
  reviewer_id       String             @db.Uuid
  reviewer          User               @relation(fields: [reviewer_id], references: [id])
  internal_notes    String             @db.Text @default("")
  author_notes      String             @db.Text @default("")
  rubric_scores     Json               @default("{}")
  decision          EditorialDecision?
  revision_deadline DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@index([manuscript_id])
  @@map("editorial_reviews")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_ref String        @unique
  manuscript_id   String        @db.Uuid
  manuscript      Manuscript    @relation(fields: [manuscript_id], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  gateway_log     Json
  invoice_url     String?
  status          PaymentStatus
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@index([transaction_ref])
  @@map("payments")
}
